&НаСервере
Процедура ПриЗакрытииНаСервере()
	
	Класс = РеквизитФормыВЗначение("Объект");
			
	Итератор = 0;

	Для каждого стр из Класс.ТЧРеквизиты Цикл
		
		Если Элементы["ЭлементТЧРеквизитыСтраницаРеквизитыКлассаСписокВыбора" + Строка(Итератор)].Родитель.Вид =  ВидГруппыФормы.Страница Тогда
			
			стр.СтраницаНаФорме = Элементы["ЭлементТЧРеквизитыСтраницаРеквизитыКлассаСписокВыбора" + Строка(Итератор)].Родитель.Имя; 
			стр.ГруппаНаСтранице = "";
			
		Иначе
			
			стр.ГруппаНаСтранице = ЭтаФорма["ТЧРеквизитыСтраницаРеквизитыКласса" + Итератор];
			
			Если Элементы["ЭлементТЧРеквизитыСтраницаРеквизитыКлассаСписокВыбора" + Строка(Итератор)].Родитель.Родитель.Родитель.Вид =  ВидГруппыФормы.Страница Тогда
				
				стр.СтраницаНаФорме = Элементы["ЭлементТЧРеквизитыСтраницаРеквизитыКлассаСписокВыбора" + Строка(Итератор)].Родитель.Родитель.Родитель.Имя; 
				
			КонецЕсли;
				
		КонецЕсли;  
		 
		Итератор = Итератор + 1;
		
	КонецЦикла;
	
	
	Итератор = 0;
		
	Для каждого стр из Класс.ТЧСтруктураТаблиц Цикл

		Если Элементы["ЭлементГруппаТЧСтруктураТаблиц" + стр.ИмяТаблицы  + Строка(Итератор)].Родитель.Вид =  ВидГруппыФормы.Страница Тогда
			
			стр.СтраницаНаФорме = Элементы["ЭлементГруппаТЧСтруктураТаблиц" + стр.ИмяТаблицы + Строка(Итератор)].Родитель.Имя; 
			стр.ГруппаНаСтранице = "";
			
		Иначе
			
			стр.ГруппаНаСтранице = ЭтаФорма["ТЧСтруктураТаблицСтраницаФормаКласса" + Итератор];
			
			Если Элементы["ЭлементТЧРеквизитыТаблицФормаКлассаСписокВыбора" + Строка(Итератор)].Родитель.Родитель.Родитель.Родитель.Вид =  ВидГруппыФормы.Страница Тогда
				
				стр.СтраницаНаФорме = Элементы["ЭлементТЧРеквизитыТаблицФормаКлассаСписокВыбора" + Строка(Итератор)].Родитель.Родитель.Родитель.Родитель.Имя; 
				
			КонецЕсли;
				
		КонецЕсли;  
		 
		Итератор = Итератор + 1;

	КонецЦикла;  
	
	Класс.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы) 
	
	ПриЗакрытииНаСервере(); 
	
КонецПроцедуры




