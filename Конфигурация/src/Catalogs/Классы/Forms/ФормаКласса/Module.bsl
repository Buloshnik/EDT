
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.ПриСозданииНаСервере(ЭтаФорма); 

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлемент(Элемент)  

	Если Лев(Элемент.ВыделенныйТекст, 6) = "Группа" тогда
		
		Если Элемент.Родитель.Вид = ВидГруппыФормы.Страница тогда  
		
			ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлементСервер(Элемент.Имя, Элемент.ВыделенныйТекст + Элемент.Родитель.Имя);
			
		ИначеЕсли Элемент.Родитель.Родитель.Вид = ВидГруппыФормы.Страница Тогда
			
			ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлементСервер(Элемент.Имя, Элемент.ВыделенныйТекст + Элемент.Родитель.Родитель.Имя);
			
		ИначеЕсли Элемент.Родитель.Родитель.Родитель.Вид = ВидГруппыФормы.Страница Тогда
			
			ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлементСервер(Элемент.Имя, Элемент.ВыделенныйТекст + Элемент.Родитель.Родитель.Родитель.Имя);
			
		КонецЕсли; 
		
	Иначе
		
		ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлементСервер(Элемент.Имя, Элемент.ВыделенныйТекст);
		
	КонецЕсли;
	
	Этаформа.ВладелецФормы.Модифицированность = Истина;
	
КонецПроцедуры  

Процедура ВыполнитьДействиеПриИзмененииДанныхСписокВыбораЭлементСервер(ЭлементИмя, ЭлементВыделенныйТекст)  
	
	Элементы.Переместить(Элементы[ЭлементИмя], Элементы[ЭлементВыделенныйТекст]);
	
КонецПроцедуры  

