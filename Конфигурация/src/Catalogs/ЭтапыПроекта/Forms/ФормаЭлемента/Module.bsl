&НаКлиенте
Процедура РасшифроватьВидео(Команда)
	
	Если не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Элемент должен быть записан.");
		возврат;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Объект.Файл) тогда
		РасшифроватьВидеоНаСервере();
	Иначе
		Сообщить("Заполните Файл.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтборФайл(СсылкаНаОбъект)
	
	Значение = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЭтапыПроектаПрисоединенныеФайлы.ВладелецФайла КАК ВладелецФайла,
		|	ЭтапыПроектаПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЭтапыПроектаПрисоединенныеФайлы КАК ЭтапыПроектаПрисоединенныеФайлы
		|ГДЕ
		|	ЭтапыПроектаПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
		|	И НЕ ЭтапыПроектаПрисоединенныеФайлы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВладелецФайла", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Значение.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции


