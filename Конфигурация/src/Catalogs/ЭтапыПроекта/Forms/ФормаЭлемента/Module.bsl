	Значение = ОтборФайл(Объект.Ссылка);
	
	Элементы.Файл.СписокВыбора.ЗагрузитьЗначения(Значение);
	
	Если Значение.Количество() = 1 Тогда 
		
		Объект.Файл = Элементы.Файл.СписокВыбора[0].Значение;
		
	КонецЕсли;
	
