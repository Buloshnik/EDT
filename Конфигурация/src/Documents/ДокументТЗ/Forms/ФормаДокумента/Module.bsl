&НаКлиенте
Процедура ТабличныйДокВыбор(Элемент, Область, СтандартнаяОбработка)
	Если СтрНайти(Область.Имя, "Ссылка") Тогда

		лСсылка=ВернутьСсылкуЭлементаТабДок(ТабличныйДок.текущаяОбласть.Верх);
		ОткрытьФормупоСсылке(лСсылка);

	ИначеЕсли СтрНайти(Область.Имя, "Картинки") Тогда
		лСсылка=ВернутьСсылкуЭлементаТабДок(ТабличныйДок.текущаяОбласть.Верх);
		ОткрытьФормупоСсылке(лСсылка);
	ИначеЕсли СтрНайти(Область.Имя, "Кнопка") Тогда
		СтандартнаяОбработка=Ложь;
		лСодержимоеЯчейки=СтрРазделить(Область.Имя, "_");
		лКоманда=лСодержимоеЯчейки[0];
		лСсылка=ВернутьСсылкуЭлементаТабДок(ТабличныйДок.текущаяОбласть.Верх);
		Если лКоманда = "КнопкаУдалитьСтолбец" Тогда
			лДанные=лСодержимоеЯчейки[2];
		ИначеЕсли лКоманда = "КнопкаДобавитьСтолбец" Тогда
			лДанные=Новый структура("Заголовок,Значение");

			лДанные.Заголовок="НовыйСтолбец" + ПОлучитьСледующийНомер();
			лДанные.Значение=ПолучитьМассивЗаголовков_Сервер(лДанные.Заголовок, Число(лСодержимоеЯчейки[1]), лСсылка);
		ИначеЕсли лКоманда = "КнопкаДобавитьСтроку" Тогда
			лДанные="НовАяСтрока";
		ИначеЕсли лКоманда = "КнопкаУдалитьСтроку" Тогда
			лДанные=Число(лСодержимоеЯчейки[1]);
		КонецЕсли;
		Если Не лСсылка = Неопределено Тогда
			ВыполнитьДействиеНаСервере(лСсылка, лКоманда, лДанные);

		Иначе
			сообщить("Не найден этап проекта!");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормупоСсылке(пСсылка)
	лПараметрыФормы = Новый Структура("Ключ", пСсылка);
	лФорма = ПолучитьФорму("Справочник.ЭтапыПроекта.ФормаОбъекта", лПараметрыФормы);
	лФорма.подчиненныеЭлементы["ТабличныеЧасти"].Видимость=Ложь;
	лФорма.подчиненныеЭлементы["Текст"].Видимость=Ложь;
	лФорма.подчиненныеЭлементы["Родитель"].Видимость=Ложь;
	лФорма.подчиненныеЭлементы["Наименование"].Видимость=Ложь;
	лФорма.подчиненныеЭлементы["Верх"].Видимость=Ложь;
	лФорма.ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыВидео", ЭтотОбъект);
	лФорма.Открыть();
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивЗаголовков_Сервер(пИмяСтолбца, пНомерСтолбца, пСсылка)

	лЗапрос=Новый Запрос;
	лЗапрос.Текст= "Выбрать *
				   |из Справочник.ЭтапыПРоекта.тчСтруктураКолонок
				   |Где Ссылка=&ссылка
				   |Упорядочить по номерСтроки	 ";
	лЗапрос.УстановитьПараметр("ссылка", пСсылка);
	лРез=лЗапрос.Выполнить().Выгрузить();
	лМассив = Новый массив(лРез.Количество() + 1, 2);
	й=0;

	Для Каждого лСтрока Из лРез Цикл
		Если лСтрока.НомерСтроки = пНомерСтолбца Тогда

			лМассив[й][0]=(пИмяСтолбца);
			лМассив[й][1]=(типЗнч(пИмяСтолбца));
			й=й + 1;
			лМассив[й][0]=(лСтрока.ИмяКОлонки);
			лМассив[й][1]=(лСтрока.ТипКолонки);
		Иначе
			лМассив[й][0]=(лСтрока.ИмяКОлонки);
			лМассив[й][1]=(лСтрока.ТипКолонки);
		КонецЕсли;
		й=й + 1;

	КонецЦикла;

	Возврат ЛМассив;
КонецФункции

