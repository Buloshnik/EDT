&НаСервере
Функция КакаяПодзадачаНаСервере(пНомерСтроки)
	лТаблицаСоответствия=РеквизитФормыВЗначение("ТАблицаСоответствия");

	Для Каждого лОбласть Из ТабличныйДок.Области Цикл
		Если Найти(лОбласть.Имя, "Подзадача") > 0 Тогда
			лСмещение=0;
			Пока лОбласть.Верх + лСмещение <= лОбласть.низ Цикл
				нСтр=лТаблицаСоответствия.Добавить();
				нСтр.ИмяОбласти=лОбласть.Имя;
				нСтр.Строка=лОбласть.Верх + лСмещение;
				лСмещение=лСмещение + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Сообщить(лТаблицаСоответствия.Количество());
	Сообщить(лТаблицаСоответствия.Найти(пНомерСтроки, "Строка").ИмяОбласти);
	лЭтап=Справочники.ЭтапыПроекта.НайтиПоКоду(Прав(лТаблицаСоответствия.Найти(пНомерСтроки, "Строка").ИмяОбласти, 9));
//	Сообщить(лЭтап);
	Возврат лЭтап;
КонецФункции

&НаСервере
Функция ВернутьСсылкуЭлементаТабДок(пНомерСтроки)
	лТаблицаСоответствия=РеквизитФормыВЗначение("ТАблицаСоответствия");

	Для Каждого лОбласть Из ТабличныйДок.Области Цикл
		Если Найти(лОбласть.Имя, "Подзадача") > 0 Тогда
			лСмещение=0;
			Пока лОбласть.Верх + лСмещение <= лОбласть.низ Цикл
				нСтр=лТаблицаСоответствия.Добавить();
				нСтр.ИмяОбласти=лОбласть.Имя;
				нСтр.Строка=лОбласть.Верх + лСмещение;
				лСмещение=лСмещение + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	//Сообщить(лТаблицаСоответствия.Количество());
	//Сообщить(лТаблицаСоответствия.Найти(пНомерСтроки,"Строка").ИмяОбласти);
	лЭтап=Справочники.ЭтапыПроекта.НайтиПоКоду(Прав(лТаблицаСоответствия.Найти(пНомерСтроки, "Строка").ИмяОбласти, 9));
	Возврат лЭтап;
КонецФункции
