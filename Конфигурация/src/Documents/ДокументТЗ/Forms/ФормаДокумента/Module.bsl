	лНаименование=ПолучитьНаименованиеСледующий(ШаблонПроекта, лГод);
	лПроект=справочники.ЭтапыПроекта.КопироватьЭлементСправочника(ШаблонПроекта, лНаименование, лДата);
	Объект.Проект=лПроект;
	//комментарий

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеСледующий(пСсылка, пГод)
	лГод=Справочники.ЭтапыПроекта.НайтиПоНаименованию(пГод, Истина, , );
	лЗапрос = Новый Запрос;
	лЗапрос.текст= "Выбрать первые 1
				   |наименование
				   |из справочник.ЭтапыПроекта
				   |где родитель в иерархии(&год)
				   |и родитель<>&год 
				   |и наименование подобно &Наименование
				   |Упорядочить по Наименование убыв
				   |";
	лЗапрос.Параметры.Вставить("год", лГод);
	лЗапрос.Параметры.Вставить("Наименование", "" + пСсылка.наименование + "%");
	лВыборка=лЗапрос.Выполнить().Выбрать();
	Если лВыборка.Следующий() Тогда
		лНовыйНомер=пСсылка.Наименование + Формат(Число(СтрЗаменить(лВыборка.Наименование, пСсылка.Наименование, ""))
			+ 1, "ЧЦ=3; ЧДЦ=0; ЧВН=;");
		Возврат лНовыйНомер;
	Иначе
		Возврат "" + пСсылка.Наименование + "001";
	КонецЕсли;
КонецФункции
#КонецОбласти


