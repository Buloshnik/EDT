&НаСервере
Процедура ПриИзмененииСодержимогоОбластиНаСервере(пИмя, пЗначение, пСмещение)
	лСсылка=КакаяПодзадачаНаСервере(пСмещение);
	//лДанные=Новый Структура();
	лМассив=СтрРазделить(пИмя, "_");
	Если СтрНайти(пИмя, "Строка") <> 0 Тогда
		лДанные = Новый Структура("ИзменитьСтроку, Колонка, Номер", пЗначение, лМассив[2], Число(лМассив[1]));
	ИначеЕсли СтрНайти(пИмя, "Шапка") <> 0 Тогда
		лДанные = Новый Структура("ИзменитьКолонку, Было", пЗначение, лМассив[1]);
	ИначеЕсли СтрНайти(пИмя, "ТекстовоеПоле") <> 0 Тогда
		лДанные =  пЗначение;
	КонецЕсли;

	Если Не лСсылка = Неопределено Тогда
		Успех=Справочники.ЭтапыПроекта.ВыполнитьДействие(лСсылка, "ИзменитьДанные", лДанные);
	Иначе
		сообщить("Не найдет этап проекта!");
	КонецЕсли;

	Сообщить("Элемент " + лСсылка + Формат(Успех, "БЛ=' Не удалось записать'; БИ=' Записан удачно';"));
КонецПроцедуры

