&НаСервере
Процедура ТабличныйДокументВывести()
	ТабличныйДок.Очистить();
	ПунктСписка="001";
	Счетчик=0;
	лОбъект=РеквизитФормыВЗначение("Объект");
	лМакет=лОБъект.ПолучитьМакет("Макет");
	лОбластьДанных=лМакет.ПолучитьОбласть("Заголовок");
	//лОбластьДанных
	ТабличныйДок.Вывести(лОбластьДанных);
КонецПроцедуры


&НаСервере
Процедура ДобавитьОбластьТабДокНаСервере(пИмяОбласти, пИмяСправочника = "")
	лОбъект=РеквизитФормыВЗначение("Объект");
	лМакет=лОБъект.ПолучитьМакет("Макет");
	лДобавкаУровня=ПолучитьУровеньЗадачи();
	лОбластьДанных=лМакет.ПолучитьОбласть(пИмяОбласти);
	Для Каждого лобласть Из лОбластьДанных.Области Цикл
		лОбласть.Имя=лОбласть.Имя + "_" + ПунктСписка + пИмяСправочника;
	КонецЦикла;
	лОбластьДанных.Область("R1C1").Текст=ПунктСписка + пИмяСправочника;
	Если лДобавкаУровня Тогда
		ТабличныйДок.Присоединить(лОбластьДанных);
	Иначе
		ТабличныйДок.Вывести(лОбластьДанных);
	КонецЕсли;
	ОбновитьПунктСписка();
	Счетчик=Счетчик + 1;

КонецПроцедуры
&НаСервере
Процедура ВставитьОбластьТабДокНаСервере(пИмяОбласти, пИмяСПР = "", пСмещение = 0)
	лОбъект=РеквизитФормыВЗначение("Объект");
	лМакет=лОБъект.ПолучитьМакет("Макет");
	//лДобавкаУровня=ПолучитьУровеньЗадачи();
	лОбластьДанных_=лМакет.ПолучитьОбласть(пИмяОбласти);
	Для Каждого лобласть Из лОбластьДанных_.Области Цикл
		лОбласть.Имя=лОбласть.Имя + "_" + ПунктСписка + пИмяСПР;
	КонецЦикла;
	лОбластьДанных_.Область("R1C1").Текст=ПунктСписка + пИмяСПР;
//	Если лДобавкаУровня тогда
//		ТабличныйДок.Присоединить(лОбластьДанных);
//	Иначе
//		ТабличныйДок.Вывести(лОбластьДанных);
//	КонецЕсли;
//	
	лВысота=лОбластьДанных_.высотаТаблицы;
	лШирина=лОбластьДанных_.ШиринаТаблицы;
	R1=((пСмещение + 1));
	C1=((1 + ТекущийУровень()));

	R2=((пСмещение + лВысота));
	C2=((лШирина + ТекущийУровень()));
	мм=Новый массив;
	//мм.Добавить(ТабличныйДок.Область(СтрСоединить(лМассивКоординат)));
	лОбластьВставки=ТабличныйДок.Область(R1, C1, R2, C2);
	лОбластьДанных=лОбластьДанных_.Область(1, 1, лВысота, лШирина);
	ТабличныйДок.ВставитьОбласть(лОбластьДанных, лОбластьВставки, ТипСмещенияТабличногоДокумента.ПоВертикали); 
	//ТабличныйДок.ВставитьОбласть(лОбластьДанных, ТабличныйДок.Область("C"+ТабличныйДок.текущаяОбласть.Верх+1));
	ОбновитьПунктСписка();
КонецПроцедуры
&НаСервере
Процедура ОбновитьПунктСписка()
	лНовыйУровень=Число(Прав(ПунктСписка, 3));
	лНовыйУровень=Формат(лНовыйУровень + 1, "ЧЦ=3; ЧДЦ=0; ЧВН=;");
	ПунктСписка=Лев(ПунктСписка, СтрДлина(ПунктСписка) - 3) + лНовыйУровень;
КонецПроцедуры

&НаСервере
Функция ПолучитьУровеньЗадачи()
	лУровень=Цел(СтрДлина(ПунктСписка) / 4);
	Если лУровень > 0 Тогда
		лОбъект=РеквизитФормыВЗначение("Объект");
		лМакет=лОБъект.ПолучитьМакет("Макет");
		S=1;
		лРезультат=лМакет.ПолучитьОбласть("Ячейка");
		ТабличныйДок.Вывести(лРезультат);
		Пока S < лУровень Цикл
			ТабличныйДок.Присоединить(лМакет.ПолучитьОбласть("Ячейка"));
			S=S + 1;
		КонецЦикла;
		Возврат Истина;
	Иначе
		Возврат Ложь;

	КонецЕсли;

КонецФункции

&НаСервере
Функция ТекущийУровень()
	Возврат Цел(СтрДлина(ПунктСписка) / 4);
КонецФункции
&НаСервере
Процедура ВывестиПодзадачу(пИмяПодзадачи)
	лОбъект=РеквизитФормыВЗначение("Объект");
	лМакет=лОБъект.ПолучитьМакет("Макет");
	лОбластьДанных=лМакет.ПолучитьОбласть("Подзадача");
	ТабличныйДок.Присоединить(лОбластьДанных);
КонецПроцедуры
&НаСервере
Процедура РазвернутьСправочникНаСервере()
	лЗапрос = Новый Запрос;
	лЗапрос.Текст =
	"ВЫБРАТЬ
	|	ЭтапыПроекта.Ссылка КАК Ссылка,
	|	ЭтапыПроекта.ВерсияДанных КАК ВерсияДанных,
	|	ЭтапыПроекта.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭтапыПроекта.Родитель КАК Родитель,
	|	ЭтапыПроекта.Код КАК Код,
	|	ЭтапыПроекта.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЭтапыПроекта КАК ЭтапыПроекта
	|	Где ссылка=(&Родитель)
	|	
	|Объединить все	
	|
	|ВЫБРАТЬ
	|	ЭтапыПроекта.Ссылка КАК Ссылка,
	|	ЭтапыПроекта.ВерсияДанных КАК ВерсияДанных,
	|	ЭтапыПроекта.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭтапыПроекта.Родитель КАК Родитель,
	|	ЭтапыПроекта.Код КАК Код,
	|	ЭтапыПроекта.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЭтапыПроекта КАК ЭтапыПроекта
	|	Где Родитель В Иерархии(&Родитель)
	|	
	|
	|	Упорядочить по код иерархия";

	лЗапрос.УстановитьПараметр("Родитель", Объект.Проект);
	лРезультат = лЗапрос.Выполнить().Выгрузить();

//лПредыдущий="";	
	лУровеньИерархии=Новый соответствие;
//лУровеньИерархии=Новый массив();
	Для Каждого лСтрока Из лРезультат Цикл
		Если лСтрока.Ссылка = Объект.Проект Тогда
			ТабличныйДокументВывести();
			лУровеньИерархии.Вставить(лСтрока.Ссылка, 0);
			лДобавочноеЧислоУровня=0;
			лПредыдущий=лСтрока;
		КонецЕсли;

		Если лСтрока.Родитель = лПредыдущий.Ссылка И лУровеньИерархии.Получить(лСтрока.Родитель) = 0 Тогда
			ДобавитьОбластьТабДокНаСервере("Подзадача", лСтрока.Наименование);
			лУровеньИерархии.Вставить(лСтрока.Ссылка, 1);
			лПредыдущий=лСтрока;
		ИначеЕсли лСтрока.Родитель = лПредыдущий.Родитель Тогда
			ДобавитьОбластьТабДокНаСервере("Подзадача", лСтрока.Наименование);
			лПредыдущий=лСтрока;
		ИначеЕсли лСтрока.Родитель = лПредыдущий.Ссылка Тогда
			лДобавочноеЧислоУровня=лДобавочноеЧислоУровня + 1;
			УровеньИзменить("+");
			лУровеньИерархии.Вставить(лСтрока.Ссылка, 1 + лДобавочноеЧислоУровня);
			ДобавитьОбластьТабДокНаСервере("Подзадача", лСтрока.Наименование);
			лПредыдущий=лСтрока;
		Иначе
			лСмещениеВлево=лДобавочноеЧислоУровня - лУровеньИерархии.Получить(лСтрока.Родитель);
			ж=0;
			Пока ж < лСмещениеВлево Цикл
				УровеньИзменить("-");
				ж=ж + 1;
			КонецЦикла;
			ДобавитьОбластьТабДокНаСервере("Подзадача", лСтрока.Наименование);
			лПредыдущий=лСтрока;
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УровеньИзменить(пНаправление)
	Если пНаправление = "-" Тогда

		Если СтрДлина(ПунктСписка) > 4 Тогда
			лМассивУровней=СтрРазделить(ПунктСписка, ".");
			лМассивУровней.Удалить(лМассивУровней.Количество() - 1);
			ПунктСписка=СтрСоединить(лМассивУровней, ".");
			ОбновитьПунктСписка();
		КонецЕсли;
	ИначеЕсли пНаправление = "+" Тогда
		ПунктСписка=ПунктСписка + ".001";
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ТестНаСервере(пСмещение)
	лОбъект=РеквизитФормыВЗначение("Объект");
	лМакет=лОБъект.ПолучитьМакет("Макет");
	//лДобавкаУровня=ПолучитьУровеньЗадачи();
	лОбластьДанных=лМакет.Область("Подзадача");
	х=0;
	Пока х < 9 Цикл
		ТабличныйДок.ВставитьОбласть( ТабличныйДок.Область("R1000"), ТабличныйДок.Область("R" + пСмещение),
			ТипСмещенияТабличногоДокумента.ПоВертикали);
		х=х + 1;
	КонецЦикла;
	ТабличныйДок.ВставитьОбласть( лОбластьДанных, , ТипСмещенияТабличногоДокумента.ПоВертикали);
КонецПроцедуры
#КонецОбласти