
&НаКлиенте
Процедура Загрузить(Команда)
	ЗагрузитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()
	
	ОчиститьСправочник();
	
	ДанныеИзФайла = ЗначениеИзФайла(ПутьКФайлу);
	
	СоответствияКлассов = Новый Соответствие;
	
	Для каждого Элемент из ДанныеИзФайла Цикл
		
		СоздатьКласс(Элемент.Ключ, Элемент.Значение, СоответствияКлассов);	
			
	КонецЦикла;
	
	Схема = Справочники.СхемаДанных.НайтиПоНаименованию(НаименованиеСхемыДанных);   
	
	Если ЗначениеЗаполнено(Схема) Тогда      
		
		СхемаОбъект = Схема.ПолучитьОбъект();
		
	Иначе
		
		СхемаОбъект = Справочники.СхемаДанных.СоздатьЭлемент();
		СхемаОбъект.Наименование = НаименованиеСхемыДанных;
		
	КонецЕсли;
	
	СхемаОбъект.ТЧКлассы.Очистить();
	
	Для каждого элемент из СоответствияКлассов Цикл    
		
		стр = СхемаОбъект.ТЧКлассы.Добавить(); 
		стр.Класс = элемент.Значение.ссылка;
		
	КонецЦикла; 
	
	СхемаОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПутьКФайлу = "D:\ФайлВыгрузкиМетаданных.txt";
	НаименованиеСхемыДанных = "Схема";
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСправочник() 
	
	Выборка = Справочники.Классы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбъектКласс = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектКласс.Удалить();
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Функция СоздатьКласс(КлючКласса, Таблицы, СоответствияКлассов, ЗагружатьТаблицы = Истина)
	
	Класс = СоответствияКлассов.Получить(КлючКласса);
	
	Если Класс = Неопределено или КлючКласса = "Составной" Тогда	
		
		Класс = Справочники.Классы.СоздатьЭлемент();
		Класс.Наименование = КлючКласса; 
		Класс.Записать();	
		СоответствияКлассов.Вставить(КлючКласса, Класс);
		
	КонецЕсли;
	
	Для каждого Строка из Таблицы["ТЧРеквизиты"] Цикл
			
		СоздатьТипыПоСтроке(Строка, Таблицы, СоответствияКлассов);	
		
	КонецЦикла;  
	
	Для каждого Строка из Таблицы["ТЧРеквизитыТаблиц"] Цикл
			
		СоздатьТипыПоСтроке(Строка, Таблицы, СоответствияКлассов);	
		
	КонецЦикла;
	
	Если ЗагружатьТаблицы Тогда     
		
		Класс.ТЧРеквизиты.Загрузить(Таблицы["ТЧРеквизиты"]);
		Класс.ТЧСтруктураТаблиц.Загрузить(Таблицы["ТЧСтруктураТаблиц"]);
		Класс.ТЧРеквизитыТаблиц.Загрузить(Таблицы["ТЧРеквизитыТаблиц"]);
		
	КонецЕсли;
	
	Класс.Записать();	
	
	Возврат Класс.Ссылка;
	
КонецФункции

&НаСервере
Процедура СоздатьТипыПоСтроке(Строка, Таблицы, СоответствияКлассов)
	
	МассивТипов = СтрРазделить(Строка.ТипРеквизита, ";", ложь);
		
	ТаблицыТипов = Новый Соответствие;
	ТаблицыТипов.Вставить("ТЧРеквизиты", Таблицы["ТЧРеквизиты"].СкопироватьКолонки());   
	ТаблицыТипов.Вставить("ТЧСтруктураТаблиц", Таблицы["ТЧСтруктураТаблиц"].СкопироватьКолонки()); 
	ТаблицыТипов.Вставить("ТЧРеквизитыТаблиц", Таблицы["ТЧРеквизитыТаблиц"].СкопироватьКолонки());

	Если МассивТипов.Количество()>1 Тогда
		
		Для каждого элемент из МассивТипов Цикл 
			
			Стр = ТаблицыТипов["ТЧРеквизиты"].Добавить();
			Стр.ИмяРеквизита = СокрЛП(элемент); 
			Стр.ТипРеквизита = СокрЛП(элемент);
			
		КонецЦикла;

		ИмяКлассаТипа = "Составной";
		ЗагружатьТаблицы = истина;
		
	Иначе  
		
		ИмяКлассаТипа = МассивТипов[0];
		ЗагружатьТаблицы = Ложь;
		
	КонецЕсли; 
	
	КлассТипа = СоздатьКласс(ИмяКлассаТипа, ТаблицыТипов, СоответствияКлассов, ЗагружатьТаблицы); 
	
	Строка.ТипРеквизита = КлассТипа.ссылка;

КонецПроцедуры 










