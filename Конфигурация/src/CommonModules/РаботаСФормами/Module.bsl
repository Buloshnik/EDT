// Создает реквизиты формы
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма, для которой выполняется обработчик. 
//  Реквизиты - РеквизитФормы, Массив - данные типа РеквизитФормы для добавления на форму
//
Процедура СоздатьРеквизиты(Форма, Реквизиты) Экспорт
	
	Если ТипЗнч(Реквизиты) <> Тип("Массив") Тогда
		ДобавляемыеРеквизиты	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Реквизиты);
	Иначе
		ДобавляемыеРеквизиты	= Реквизиты;	
	КонецЕсли;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты); 
	
КонецПроцедуры

// Создает команду формы
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения - форма, для которой выполняется обработчик.
//	ИмяКоманды - Строка - Имя команды
//  Заголовок - Строка - Заголовок команды
//  ИмяДействия - Строка - Имя процедуры действия команды
//
// Возвращаемое значение:
//	КомандаФормы - новая команда формы
//
Функция СоздатьКоманду(Форма, ИмяКоманды, Заголовок, ИмяДействия) Экспорт
	
	КомандаФормы	= Форма.Команды.Найти(ИмяКоманды);
	
	Если КомандаФормы = Неопределено Тогда
		КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
		КомандаФормы.Заголовок = Заголовок;
		КомандаФормы.Действие = ИмяДействия;
	КонецЕсли;
	
	Возврат КомандаФормы;
	
КонецФункции

// Возвращает свойства обычной группы формы без отображения
// 
// Возвращаемое значение:
//  Структура - свойства группы формы
//
Функция СвойстваОбычнойГруппыБезОтображения() Экспорт

	Результат	= Новый Структура;
	
	Результат.Вставить("Вид"				, ВидГруппыФормы.ОбычнаяГруппа);
	Результат.Вставить("ОтображатьЗаголовок", Ложь);
	Результат.Вставить("Отображение"		, ОтображениеОбычнойГруппы.Нет);
	
	Возврат Результат;
	
КонецФункции

// Создает реквизит формы с типом динамический список
//
// Параметры:
//  Форма			 - ФормаКлиентскогоПриложения	 - форма, для которой выполняется обработчик.
//  Имя				 - Строка	 - имя реквизита формы.
//  ОсновнаяТаблица	 - Строка, Неопределено	 - имя основной таблицы динамического списка.
//  ТекстЗапроса	 - Строка, Неопределено - текст запроса динамического списка.
//  ПараметрыЗапроса - Структура, Неопределено	 - параметры запроса динамического списка.
//
Процедура СоздатьРеквизитДинамическийСписок(Форма, Имя, ОсновнаяТаблица = Неопределено, ТекстЗапроса = Неопределено, ПараметрыЗапроса = Неопределено) Экспорт
	
	Если ПараметрыЗапроса = Неопределено Тогда
		ПараметрыЗапроса = Новый Структура;
	КонецЕсли;
	 
	СоздатьРеквизиты(Форма, РеквизитФормы(Имя, ОписаниеТипаДинамическийСписок())); 
	
	Реквизит = Форма[Имя];
	
	Реквизит.ТекстЗапроса 		= ТекстЗапроса;
	Реквизит.ПроизвольныйЗапрос = ЗначениеЗаполнено(ТекстЗапроса);
	Реквизит.ОсновнаяТаблица 	= ОсновнаяТаблица;
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Реквизит, Параметр.Ключ, Параметр.Значение); 
	КонецЦикла;
	
КонецПроцедуры

