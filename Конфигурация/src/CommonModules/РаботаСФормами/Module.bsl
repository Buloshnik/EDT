#Область ДобавлениеИзменениеЭлементовФормы

Функция СоздатьЭлементФормы(Форма, Имя, ТипЭлемента, Знач Родитель, ЭлементПеред)
	
	ЭлементФормы = Форма.Элементы.Найти(Имя);
	
	Если ТипЗнч(Родитель) = Тип("Строка") Тогда
		Родитель	= Форма.Элементы.Найти(Родитель);	
	КонецЕсли;
	
	Если ЭлементФормы <> Неопределено Тогда
		Форма.Элементы.Переместить(ЭлементФормы, Родитель, ЭлементПеред);
	ИначеЕсли ЭлементПеред = Неопределено Тогда
		ЭлементФормы = Форма.Элементы.Добавить(Имя, ТипЭлемента, Родитель);
	Иначе
		ЭлементФормы = Форма.Элементы.Вставить(Имя, ТипЭлемента, Родитель, ЭлементПеред);
	КонецЕсли;
	
	Возврат ЭлементФормы;
	
КонецФункции

Процедура УстановитьСвойстваЭлементу(Элемент, Свойства)
	
	Если Свойства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Свойство Из Свойства Цикл
		Элемент[Свойство.Ключ] = Свойство.Значение;	
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСобытияЭлементу(Элемент, События)
	
	Если События = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Событие Из События Цикл
		
		ОбработчикСобытия	= Элемент.ПолучитьДействие(Событие.Ключ);
		Если ЗначениеЗаполнено(ОбработчикСобытия) Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент.УстановитьДействие(Событие.Ключ, Событие.Значение);	
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция РеквизитФормы(Имя, Тип, Путь = Неопределено, Заголовок = Неопределено, СохраняемыеДанные = Ложь)

	Возврат Новый РеквизитФормы(Имя, Тип, Путь, Заголовок, СохраняемыеДанные);
	
КонецФункции

#Область СправочникКлассы


Процедура ОбновитьЭлементыФормы_Справочник_Классы_ФормаЭлемента(Форма)     
	
	Объект	= Форма.Объект;
	
	СвойстваГруппы	= Новый Структура("Вид, Заголовок", ВидГруппыФормы.Страница, "Реквизиты класса");
	СтраницаРеквизитыКласса	= СоздатьГруппу(Форма, "СтраницаРеквизитыКласса", Форма.Элементы.Страницы, , СвойстваГруппы);
	
	Итерратор = 0;     
			
	Для каждого Реквизит из Объект.ТЧРеквизиты Цикл
				
		ДобавляемыеРеквизиты = Новый массив;     
		РеквизитФормы = РеквизитФормы("ТЧРеквизиты" + Строка(Итерратор), Новый ОписаниеТипов("Строка"), , Реквизит.ИмяРеквизита);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		СвойстваПоля	= Новый Структура("Доступность , ТолькоПросмотр", Истина, Истина);
		СоздатьПолеВвода(Форма, "ЭлементТЧРеквизиты" + Строка(Итерратор), СтраницаРеквизитыКласса, "ТЧРеквизиты" + Строка(Итерратор), , СвойстваПоля);
		
		Итерратор = Итерратор +1;
		
	КонецЦикла;  

	Итерратор = 0;
	
	Для каждого Команда из Объект.ТЧКоманды Цикл
		
		
		СоздатьКоманду(Форма, "ТЧКоманды" + Строка(Итерратор), Команда.ИмяКоманды, "ТЧКоманды" + Строка(Итерратор)); 
		
		СвойстваПоля	= Новый Структура("ИмяКоманды", "ТЧКоманды" + Строка(Итерратор));
		СоздатьКнопку(Форма, "КнопкаТЧКоманды" + Строка(Итерратор), СтраницаРеквизитыКласса, , СвойстваПоля);
		
		Итерратор = Итерратор +1;
		
	КонецЦикла;
	
	Итерратор = 0;
	
	Для каждого стрСтруктураТаблиц из Объект.ТЧСтруктураТаблиц Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИмяТаблицы", стрСтруктураТаблиц.ИмяТаблицы);  
		
		СтрокиТЧРеквизитыТаблиц = Объект.ТЧРеквизитыТаблиц.НайтиСтроки(Отбор);
		
		СвойстваГруппы	= Новый Структура("Вид, Заголовок", ВидГруппыФормы.Страница, стрСтруктураТаблиц.ИмяТаблицы);
		СтраницаТаблица	= СоздатьГруппу(Форма, стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор), Форма.Элементы.Страницы, , СвойстваГруппы);
		
		ДобавляемыеРеквизиты = Новый массив;     
		РеквизитФормы = РеквизитФормы("ТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор), Новый ОписаниеТипов("ТаблицаЗначений"), , стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор));
		ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
		
		Для каждого стр из СтрокиТЧРеквизитыТаблиц Цикл 
			
			РеквизитФормы = РеквизитФормы("ТЧРеквизитыТаблиц" + стр.ИмяТаблицы + стр.ИмяРеквизита + Строка(Итерратор), Новый ОписаниеТипов("Строка"), "ТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор), стр.ИмяРеквизита);
			ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
			
		КонецЦикла;
		
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		СвойстваТаблицы	= Новый Структура("ПутьКДанным", "ТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор));
		СоздатьТаблицуФормы(Форма, "ЭлементТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор), СтраницаТаблица, , СвойстваТаблицы);
		
		СвойстваПоля	= Новый Структура("Доступность , ТолькоПросмотр", Истина, Истина);
		Для каждого стр из СтрокиТЧРеквизитыТаблиц Цикл 
				
			СоздатьПолеВвода(Форма, 
							"ЭлементТЧРеквизитыТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + стр.ИмяРеквизита + Строка(Итерратор), 
							Форма.Элементы["ЭлементТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор)], 
							"ТЧСтруктураТаблиц" + стрСтруктураТаблиц.ИмяТаблицы + Строка(Итерратор) + "." + "ТЧРеквизитыТаблиц" + стр.ИмяТаблицы + стр.ИмяРеквизита + Строка(Итерратор), 
							, 
							СвойстваПоля);
		                
		КонецЦикла;     
	
	КонецЦикла;

КонецПроцедуры

