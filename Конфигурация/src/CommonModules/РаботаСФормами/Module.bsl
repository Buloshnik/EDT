// Создает группу формы по переданным параметрам
//
// Параметры:
//	Форма 			- ФормаКлиентскогоПриложения - форма, для которой выполняется обработчик.
//	Имя	 			- Строка - имя нового элемента 
//	Родитель		- ГруппаФормы, ТаблицаФормы, Строка	- группа формы (куда поместить)
//	ЭлементПеред	- ДекорацияФормы, ГруппаФормы, КнопкаФормы, ТаблицаФормы, ПолеФормы - элемент перед которым нужно вставить новое поле
//	Свойства		- Структура - свойства элемента формы которые нужно инициализировать
//	События			- Структура - события элемента формы которые нужно инициализировать
//
// Возвращаемое значение:
//	ГруппаФормы - группа формы
//
Функция СоздатьГруппу(Форма, Имя, Родитель, ЭлементПеред = Неопределено, Свойства = Неопределено, События = Неопределено) Экспорт
	
	ЭлементФормы = СоздатьЭлементФормы(Форма, Имя, Тип("ГруппаФормы"), Родитель, ЭлементПеред);
		
	УстановитьСвойстваЭлементу(ЭлементФормы, Свойства);
	УстановитьСобытияЭлементу(ЭлементФормы, События);
	
	Возврат ЭлементФормы;
	
КонецФункции 

// Создает поле формы по переданным параметрам
//
// Параметры:
//	Форма 			- ФормаКлиентскогоПриложения - форма, для которой выполняется обработчик.
//	Имя	 			- Строка - имя нового элемента 
//	Родитель		- ГруппаФормы, ТаблицаФормы, Строка	- группа формы (куда поместить)
//	ЭлементПеред	- ДекорацияФормы, ГруппаФормы, КнопкаФормы, ТаблицаФормы, ПолеФормы - элемент перед которым нужно вставить новое поле
//	Свойства		- Структура - свойства элемента формы которые нужно инициализировать
//	События			- Структура - события элемента формы которые нужно инициализировать
//
// Возвращаемое значение:
//	ПолеФормы - новое поле формы
//
Функция СоздатьПоле(Форма, Имя, Родитель, ЭлементПеред = Неопределено, Свойства = Неопределено, События = Неопределено) Экспорт
	
	ЭлементФормы = СоздатьЭлементФормы(Форма, Имя, Тип("ПолеФормы"), Родитель, ЭлементПеред);
		
	УстановитьСвойстваЭлементу(ЭлементФормы, Свойства);
	УстановитьСобытияЭлементу(ЭлементФормы, События);
	
	Возврат ЭлементФормы;
	
КонецФункции 

// Создает поле формы вида "ПолеВвода" по переданным параметрам
//
// Параметры:
//	Форма 			- ФормаКлиентскогоПриложения - форма, для которой выполняется обработчик.
//	Имя	 			- Строка - имя нового элемента 
//	Родитель		- ГруппаФормы, ТаблицаФормы, Строка	- группа формы (куда поместить)
//	ПутьКДанным		- Строка - данные, с которыми связан элемент
//	ЭлементПеред	- ДекорацияФормы, ГруппаФормы, КнопкаФормы, ТаблицаФормы, ПолеФормы - элемент перед которым нужно вставить новое поле
//	Свойства		- Структура - свойства элемента формы которые нужно инициализировать
//	События			- Структура - события элемента формы которые нужно инициализировать
//
// Возвращаемое значение:
//	ПолеФормы - новое поле формы
//
Функция СоздатьПолеВвода(Форма, Имя, Родитель, ПутьКДанным, ЭлементПеред = Неопределено, Свойства = Неопределено, События = Неопределено) Экспорт
	
	СвойстваПоля	= Новый Структура;
	СвойстваПоля.Вставить("Вид"			, ВидПоляФормы.ПолеВвода);
	СвойстваПоля.Вставить("ПутьКДанным"	, ПутьКДанным);
	
	Если Свойства <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(СвойстваПоля, Свойства, Ложь);
	КонецЕсли;
	
	Возврат СоздатьПоле(Форма, Имя, Родитель, ЭлементПеред, СвойстваПоля, События);
	
КонецФункции  

